Windows Registry Editor Version 5.00

[-HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\Image Compressor]
"Position"="Middle"
"icon"="cmd.exe"
"SubCommands"=""

[-HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\Image Compressor\shell\FIX_IT]
@="&FIX_IT"
"icon"="cmd.exe"
"MUIVerb"="FIX_IT"
[-HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\Image Compressor\shell\FIX_IT\command]
@="\"C:\\Image Compressor\\Fix-It.bat\" \"%1\""


